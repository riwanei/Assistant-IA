{
  "name": "riwane-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env agent/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "demo": "node agent/demo.ts",
    "prepare:workspace": "node scripts/prepare.ts",
    "test:model": "node --env-file-if-exists=.env scripts/smoke-model.ts",
    "voice": "node --env-file-if-exists=.env agent/web.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
